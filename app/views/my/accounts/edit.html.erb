<div class="mx-auto max-w-md w-full">
  <%= render "shared/title", title: "Edit Account" %>

  <div class="rounded-lg bg-white p-6 shadow-sm">
    <%= form_with model: @user, url: my_account_path, method: :patch, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-100 text-red-800 p-3 rounded">
          <ul class="list-disc pl-5">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :first_name, class: label_classes %>
        <%= f.text_field :first_name, class: input_classes, placeholder: "First name" %>
      </div>

      <div>
        <%= f.label :last_name, class: label_classes %>
        <%= f.text_field :last_name, class: input_classes, placeholder: "Last name" %>
      </div>

      <div>
        <label class="<%= label_classes %>">Email</label>
        <p class="px-3 py-2 text-gray-500 text-sm"><%= @user.email_address %></p>
      </div>

      <div class="flex justify-between pt-2">
        <%= link_to "Cancel", my_account_path, class: "text-gray-500 hover:text-black" %>
        <%= f.submit "Save", class: link_primary_classes %>
      </div>
    <% end %>
  </div>
</div>
